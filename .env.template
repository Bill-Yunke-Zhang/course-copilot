# Copy this file to .env and fill in values before starting the stack.
# Never commit .env to version control.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PASSWORD=change_me_app

# MySQL URL (used by SQLAlchemy + Alembic)
DATABASE_URL=mysql+pymysql://app_user:change_me_app@mysql:3306/copilot

# --- Redis (agent job queue) ---
REDIS_URL=redis://redis:6379/0

# --- LLM: Google Cloud Vertex AI via the google-genai SDK ---
# There is no API key: wisc.edu's Google Cloud blocks them. You sign in once
# with `gcloud auth application-default login` (Application Default
# Credentials, ADC), following https://handouts-1a578e.pages.doit.wisc.edu/gemini-api-setup.html
# Did that for Lecture 15? Copy the same two lines from that .env.
# All agent reasoning/classification/verification calls bill this project,
# and every call's token usage + cost is logged per AgentRun (see §13).
#
# Your Google Cloud project ID (not its display name). Not a secret.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# The folder where gcloud saved your sign-in, mounted read-only into the
# backend and worker. macOS/Linux: ~/.config/gcloud
# Windows: ~/AppData/Roaming/gcloud
GCLOUD_CONFIG_DIR=

# Model used for ALL LLM calls (classification, agent generation, grounding
# verification). Default is the same low-cost model the lectures use. You
# can point specific call purposes at different models with the optional
# overrides below.
LLM_MODEL=gemini-3.5-flash-lite

# Optional per-purpose overrides (leave blank to use LLM_MODEL for everything):
LLM_MODEL_CLASSIFICATION=
LLM_MODEL_GENERATION=
LLM_MODEL_VERIFICATION=

# Optional: route ALL LLM traffic to a different endpoint instead of Google.
# Used with the local mock LLM service for keyless development and
# deterministic tests:  set LLM_BASE_URL=http://mock-llm:9000 (no Google sign-in
# needed), and start with `docker compose --profile
# mock up`.  GRADED CONTRACT: your app must honor LLM_BASE_URL and
# LLM_MODEL — grading runs your containers against a mock endpoint with
# scripted responses.
LLM_BASE_URL=

# --- Repo resources ---
# Where GitLab repos are cloned inside the containers (a named docker volume).
REPO_CLONE_DIR=/data/repos

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
